{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/api/frontend/:path*", "destination": "/api/frontend/:path*" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/api/frontend/$1" }
  ],
  "functions": {
    "api/[...path].js": {
      "runtime": "nodejs24.x"
    }
  }
}
